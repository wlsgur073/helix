    "name": "wlsgur073"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wlsgur073/helix.git"
  },
  "keywords": [
    "memory",
    "mcp",
    "provenance",
    "dual-verify",
    "claude-code"
  ],
  "mcpServers": {
    "helix": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/helix-mcp.mjs"
      ]
    }
  }
}
