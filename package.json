{
  "name": "helix",
  "version": "0.1.0",
  "private": true,
  "description": "Verifiable, trust-indexed cross-session memory for Claude Code (provenance firewall, fail-closed) with optional Codex dual-verify.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wlsgur073/helix.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "freeze-guard": "tsx scripts/freeze-guard.ts",
    "scan:history": "tsx scripts/scan-history-secrets.ts",
    "inventory": "tsx scripts/inventory/build-inventory.ts",
    "certify-gate": "tsx scripts/inventory/certify-gate.ts",
    "cut-candidate": "tsx scripts/inventory/cut-candidate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "tsx": "4.23.5",
    "typescript": "6.0.3",
    "vitest": "4.1.8"
  },
  "overrides": {
    "fast-uri": "3.1.5"
  }
}
